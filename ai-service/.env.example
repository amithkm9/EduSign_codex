# EduSign AI service
OPENAI_API_KEY=sk-your-openai-api-key
AI_SERVICE_PORT=8100
# Shared secret the Next gateway must send (X-Internal-Token). Must match the
# gateway's INTERNAL_API_TOKEN. Generate: `openssl rand -hex 32`. Empty = open (local only).
INTERNAL_API_TOKEN=

# Optional model overrides. The tutor model must support structured JSON output.
OPENAI_TUTOR_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
